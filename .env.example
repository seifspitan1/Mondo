# ==============================================================================
# MONDO Environment Configuration Template
# Copy this file to .env and provide your deployment secrets.
# Do not commit .env to version control.
# ==============================================================================

# Local server port
PORT=3000

# Node runtime environment (development | production)
NODE_ENV=development

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
# Optional: ADMIN_PASSWORD_HASH (SHA-256 hash of password)
# ADMIN_PASSWORD_HASH=

# JWT Session Secret (use at least 32 random characters)
JWT_SECRET=your_random_32_character_jwt_secret_here

# Supabase PostgreSQL & Storage Configuration
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Supabase Storage Bucket for portfolio images and trailers
SUPABASE_STORAGE_BUCKET=mondo-media
